{
  "name": "wexample/symfony-platform",
  "description": "The assembled base of a management application: what every app of the kind keeps, starting with its configuration",
  "type": "library",
  "license": "MIT",
  "version": "5.0.1",
  "autoload": {
    "psr-4": {
      "Wexample\\SymfonyPlatform\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Wexample\\SymfonyPlatform\\Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "weeger",
      "email": "romain.weeger@wexample.com"
    }
  ],
  "require": {
    "php": ">=8.5",
    "doctrine/orm": "^3.0",
    "symfony/uid": ">=6.2",
    "wexample/php-pseudocode": ">=3.1.0",
    "wexample/symfony-api": ">=19.0.0",
    "wexample/symfony-helpers": ">=19.3.0",
    "wexample/symfony-pseudocode": ">=4.0.2",
    "wexample/symfony-preference": ">=3.0.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^13"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../*",
      "options": {
        "symlink": true
      }
    }
  ],
  "extra": {
    "install": {
      "bundle_env": "all"
    }
  }
}